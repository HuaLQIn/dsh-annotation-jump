{
    "name":  "@changfenhuang/dsh-annotation",
    "version":  "1.5.0",
    "type":  "module",
    "description":  "DSH Web selection-annotation plugin: select assistant text, annotate (optional), and press Enter to send the annotation block with your message — the model replies to each annotation by number, with hoverable chips in the reply.",
    "main":  "lib/index.js",
    "types":  "lib/types/index.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./lib/types/index.d.ts",
                              "default":  "./lib/index.js"
                          },
                    "./client":  "./client.js",
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "lib",
                  "src",
                  "tsconfig.json",
                  "client.js",
                  "cordis.patch.yml",
                  "README.md",
                  "README.zh-CN.md",
                  "LICENSE",
                  "CHANGELOG.md"
              ],
    "scripts":  {
                    "test":  "node --check client.js \u0026\u0026 node --check lib/index.js"
                },
    "publishConfig":  {
                          "access":  "public"
                      },
    "peerDependencies":  {
                             "cordis":  "^4.0.0-rc.7 || ^4.0.1"
                         },
    "devDependencies":  {
                            "typescript":  "^5.9.0"
                        },
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "inject":  [
                                              "@deepseek-ai/dsh-client-ui-session",
                                              "@deepseek-ai/dsh-client-ui-conversation",
                                              "@deepseek-ai/dsh-client-locale"
                                          ],
                               "platform":  "web"
                           }
            },
    "license":  "MIT",
    "author":  "HuaLQIn (https://github.com/HuaLQIn)",
    "engines":  {
                    "node":  "\u003e=20"
                },
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/HuaLQIn/dsh-annotation-jump.git"
                   },
    "homepage":  "https://github.com/HuaLQIn/dsh-annotation-jump#readme",
    "bugs":  {
                 "url":  "https://github.com/HuaLQIn/dsh-annotation-jump/issues"
             }
}
